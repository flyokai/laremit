APP_NAME=Laremit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Host port map. Consumed by compose.yaml only — the app always reaches services
# by their compose hostname on their native port.
# -----------------------------------------------------------------------------
APP_PORT=8100
DB_PORT_HOST=33100
REDIS_CACHE_PORT_HOST=6301
REDIS_QUEUE_PORT_HOST=6302
REDIS_STREAM_PORT_HOST=6303

# The bind-mounted source is written by the container; match the host user.
UID=1000
GID=1000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laremit
DB_USERNAME=laremit
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# -----------------------------------------------------------------------------
# Redis — three physically separate instances (ADR-002)
#
#   cache   evictable, no persistence      allkeys-lru
#   queue   promised work, must not evict  noeviction + AOF
#   stream  event ingest buffer            noeviction + AOF, app-side trimming
#
# Do not collapse these onto one instance by pointing the hosts at each other:
# the queue-isolation demo in Phase 6 depends on them being separate processes.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_PREFIX=laremit:

REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=null

REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_PASSWORD=null

REDIS_STREAM_HOST=redis-stream
REDIS_STREAM_PORT=6379
REDIS_STREAM_PASSWORD=null

# -----------------------------------------------------------------------------
# Drivers
# -----------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Event ingestion (Phase 2)
#
# The invariant EVENTS_SHED_ABOVE < EVENTS_REJECT_ABOVE < EVENTS_STREAM_MAXLEN
# is enforced at boot (ADR-003): ingestion must refuse work before stream
# trimming could ever reach an unconsumed event.
# -----------------------------------------------------------------------------
EVENTS_INGEST_TOKEN=local-dev-token
EVENTS_STREAM_MAXLEN=1000000
EVENTS_SHED_ABOVE=500000
EVENTS_REJECT_ABOVE=900000
EVENTS_DEDUP_TTL=900
EVENTS_RETENTION_MONTHS=13

HORIZON_PREFIX=laremit-horizon:

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@laremit.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Billing / payments (Phase 3)
#
# The PSP endpoints use compose service DNS (http://app:8080): jobs run in the
# horizon container, and "localhost" there is not the app.
# -----------------------------------------------------------------------------
BILLING_API_TOKEN=local-billing-token
BILLING_PSP_DRIVER=http
BILLING_PSP_BASE_URL=http://app:8080/mock-psp
BILLING_PSP_TIMEOUT=3.0
PSP_WEBHOOK_SECRET=local-psp-secret
MOCKPSP_ENABLED=true
MOCKPSP_WEBHOOK_URL=http://app:8080/v1/psp/webhook

# -----------------------------------------------------------------------------
# Webhooks, app stores, reconciliation (Phase 4)
#
# The mock stores sign App Store notifications with MOCK_APPLE_SIGNING_KEY and
# the app verifies them against APPLE_ASSN_PUBLIC_KEY (both base64 PEM). This
# is a throwaway dev key pair committed on purpose: nothing real ever signs
# with it. In production the public half is Apple's root CA (tech-debt #12).
# -----------------------------------------------------------------------------
BILLING_STORES_DRIVER=http
BILLING_STORES_BASE_URL=http://app:8080/mock-stores
BILLING_STORES_ENVIRONMENT=Sandbox
APPLE_ASSN_PUBLIC_KEY=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFb1A4bk9KMkFhci9abjRSWXNWUVB1VmljT0E5NwpFTWgzVXg1bkNJY1lVUnFjVUphODRkd0FHcXk2K3NWOEp2NnZPcUlUSFQ4dnJrL25OZzI3VjA3emtnPT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg==
GOOGLE_RTDN_TOKEN=local-rtdn-token
MOCKSTORES_ENABLED=true
MOCKSTORES_ENVIRONMENT=Sandbox
MOCK_APPLE_SIGNING_
MOCKSTORES_APPLE_NOTIFICATION_URL=http://app:8080/v1/iap/apple/notifications
MOCKSTORES_GOOGLE_NOTIFICATION_URL=http://app:8080/v1/iap/google/notifications

# -----------------------------------------------------------------------------
# Outbox & domain events (Phase 5)
#
# The relay polls for committed outbox rows and republishes them into the
# event stream; the alarm threshold is what outbox:status --check pages on.
# -----------------------------------------------------------------------------
OUTBOX_RELAY_BATCH=200
OUTBOX_RELAY_SLEEP_MS=500
OUTBOX_MAX_BACKLOG_AGE=300
OUTBOX_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Queue lanes (Phase 6, ADR-007)
#
# retry_after per lane — the visibility timeout. The invariant, enforced by
# QueueTopologyTest: each value exceeds the slowest job timeout on that lane
# (payments 60s, events 30s, bulk 300s) with margin, or a second worker starts
# a charge the first is still making.
# -----------------------------------------------------------------------------
QUEUE_PAYMENTS_RETRY_AFTER=90
QUEUE_EVENTS_RETRY_AFTER=60
QUEUE_BULK_RETRY_AFTER=330
