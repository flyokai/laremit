<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Jobs pinned to a lane connection (ADR-007) ignore QUEUE_CONNECTION,
             so the lanes carry their own sync switch for the suite. -->
        <env name="QUEUE_LANES_DRIVER" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="EVENTS_INGEST_TOKEN" value="test-token"/>
        <env name="BILLING_API_TOKEN" value="test-billing-token"/>
        <env name="BILLING_PSP_DRIVER" value="loopback"/>
        <env name="PSP_WEBHOOK_SECRET" value="test-psp-secret"/>
        <env name="MOCKPSP_WEBHOOK_DELAY_MIN" value="0"/>
        <env name="MOCKPSP_WEBHOOK_DELAY_MAX" value="0"/>
        <env name="MOCKPSP_WEBHOOK_DUPLICATE_RATE" value="0"/>
        <env name="MOCKPSP_WEBHOOK_DROP_RATE" value="0"/>
        <env name="BILLING_STORES_DRIVER" value="loopback"/>
        <env name="BILLING_STORES_ENVIRONMENT" value="Sandbox"/>
        <env name="GOOGLE_RTDN_TOKEN" value="test-rtdn-token"/>
        <!-- A throwaway ES256 pair for the mock App Store; nothing real signs with it. -->
        <env name="APPLE_ASSN_PUBLIC_KEY" value="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFb1A4bk9KMkFhci9abjRSWXNWUVB1VmljT0E5NwpFTWgzVXg1bkNJY1lVUnFjVUphODRkd0FHcXk2K3NWOEp2NnZPcUlUSFQ4dnJrL25OZzI3VjA3emtnPT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg=="/>
        <env name="MOCK_APPLE_SIGNING_KEY" value=""/>
        <env name="MOCKSTORES_DELAY_MIN" value="0"/>
        <env name="MOCKSTORES_DELAY_MAX" value="0"/>
        <env name="MOCKSTORES_DUPLICATE_RATE" value="0"/>
        <env name="MOCKSTORES_DROP_RATE" value="0"/>
        <!-- Event pipeline integration tests hit the real stream and cache
             Redis instances via the host port map, but on database 9 with a
             test prefix, so they can never touch development data. The tests
             skip themselves when the containers are down. -->
        <env name="REDIS_PREFIX" value="laremit-test:"/>
        <env name="REDIS_STREAM_HOST" value="127.0.0.1"/>
        <env name="REDIS_STREAM_PORT" value="6303"/>
        <env name="REDIS_STREAM_DB" value="9"/>
        <env name="REDIS_CACHE_HOST" value="127.0.0.1"/>
        <env name="REDIS_CACHE_PORT" value="6301"/>
        <env name="REDIS_CACHE_DB" value="9"/>
        <!-- The flood-command integration test pushes real payloads to the
             queue instance, same database-9-plus-test-prefix isolation. -->
        <env name="REDIS_QUEUE_HOST" value="127.0.0.1"/>
        <env name="REDIS_QUEUE_PORT" value="6302"/>
        <env name="REDIS_QUEUE_DB" value="9"/>
        <env name="HORIZON_PREFIX" value="laremit-test-horizon:"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
