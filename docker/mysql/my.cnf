[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
skip-name-resolve

# READ COMMITTED rather than MySQL's REPEATABLE READ default: the billing paths
# take short row locks (SELECT ... FOR UPDATE on payment_intents) and REPEATABLE
# READ's gap/next-key locks turn concurrent charges for different users into
# lock waits on the same index range. Binary logging is row-based by default in
# 8.4, so this is safe for replication.
transaction_isolation = READ-COMMITTED

# Durability is not negotiable for a ledger: every committed transaction is
# fsynced. If a load test needs more write throughput, relax this knowingly and
# record it — do not discover it later.
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_buffer_pool_size = 512M
innodb_redo_log_capacity = 256M

max_connections = 300
