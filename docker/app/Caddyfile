{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		# Worker mode arrives here from compose.yaml (Phase 8, ADR-008):
		#   FRANKENPHP_CONFIG="worker /app/public/frankenphp-worker.php"
		# An empty value serves classic mode from the same image — the A/B
		# switch behind the before/after table in docs/load-tests.md.
		{$FRANKENPHP_CONFIG}
	}

	# TLS is terminated upstream in every environment we target, and persisting
	# Caddy state would require a writable volume for no benefit.
	auto_https off
	admin off
	persist_config off
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		output stderr
		format json
	}

	root /app/public
	encode zstd br gzip

	php_server {
		# Registering the worker script (FRANKENPHP_CONFIG above) is only half
		# of worker mode: FrankenPHP hands a request to the worker only when
		# the request RESOLVES to the worker's file, so the index must switch
		# with it. Classic mode (both vars empty) resolves to index.php.
		index {$FRANKENPHP_INDEX:index.php}
	}
}
