includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest/extension.neon

parameters:
    # Raised from the Phase 1 baseline (6) in Phase 7 by fixing the 13-error
    # delta — no baseline file, no ignores. Raise further only the same way.
    level: 7

    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tests

    excludePaths:
        analyseAndScan:
            # Pest binds $this inside test closures to the extended TestCase at
            # runtime; PHPStan sees Pest\PendingCalls\TestCall and reports every
            # $this->getJson() as an undefined method. The fix is
            # pestphp/pest-plugin-phpstan, which requires Pest 5 and therefore
            # PHPUnit 13, while Laravel 13 pins PHPUnit 12. Revisit when that
            # lands — tracked in docs/tech-debt.md. Test-support classes below
            # these directories are real classes and stay analysed.
            # tests/Arch trips the same limitation from the other side:
            # arch()->preset()/->expect() aren't on Pest's TestCall stub.
            - tests/Arch
            - tests/Feature
            - tests/Unit

    tmpDir: storage/framework/cache/phpstan
